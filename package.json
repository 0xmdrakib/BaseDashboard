{
  "name": "orbit-analytics",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "node scripts/build-sdk.mjs && next build --webpack",
    "sdk:build": "node scripts/build-sdk.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/analytics.test.ts tests/sdk.test.ts tests/app-config.test.ts",
    "test:api": "node --test tests/api.test.mjs",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "pg": "^8.23.1",
    "posthog-js": "^1.438.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "description": "An analytics dashboard for builders on Base. Track wallets, transactions, funnels, retention, and product activity with PostHog.",
  "license": "MIT",
  "author": "Md. Rakib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xmdrakib/BaseDashboard.git"
  },
  "bugs": {
    "url": "https://github.com/0xmdrakib/BaseDashboard/issues"
  }
}
