# Public values for an app using the Orbit SDK (Next.js)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_ORBIT_APP_ID=
# Public values for an app using the Orbit SDK (Vite)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_ORBIT_APP_ID=
# Dashboard runtime configuration: configure these as Sites environment variables.
POSTHOG_PROJECT_ID=
POSTHOG_PUBLIC_KEY=
POSTHOG_REGION=us
# SECRET: query:read scoped personal API key. Server-side ONLY.
POSTHOG_PERSONAL_API_KEY=
